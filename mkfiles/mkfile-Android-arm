# Android ARMv7 NativeActivity, built with the modern NDK LLVM toolchain.
TARGMODEL= Posix
TARGSHTYPE= sh
CPUS= arm
O= o
OS= o
NDK_TOOLCHAIN= $ANDROID_NDK_HOME/toolchains/llvm/prebuilt/linux-x86_64/bin
ANDROID_API= 21
AR= $NDK_TOOLCHAIN/llvm-ar
ARFLAGS= rcs
AS= $NDK_TOOLCHAIN/armv7a-linux-androideabi$ANDROID_API-clang -c
ASFLAGS= -marm -fPIC
CC= $NDK_TOOLCHAIN/armv7a-linux-androideabi$ANDROID_API-clang -c
CFLAGS= -O2 -g -marm -fPIC -fno-strict-aliasing\
 -I$ROOT/Android/arm/include -I$ROOT/include\
 -DANDROID -DLINUX_ARM $EXTWINFLAGS $DISMODELFLAGS
ANSICPP=
LD= $NDK_TOOLCHAIN/armv7a-linux-androideabi$ANDROID_API-clang
LDFLAGS= -llog
SYSLIBS= -lm
YACC= iyacc
YFLAGS= -d
