CPUS=		arm

O=		o
OS=		o

AR=		${CROSS}ar
ARFLAGS=	ruvs

AS=		${CROSS}gcc -c 
ARMFPFLAGS=	# optional -mfpu/-mfloat-abi target flags for both C and assembly
