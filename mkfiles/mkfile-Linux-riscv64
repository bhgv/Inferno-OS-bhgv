# Native Linux riscv64 core/library profile; see doc/build-native64.md for port limits.
TARGMODEL= Posix
TARGSHTYPE= sh
CPUS= riscv64
O= o
OS= o
AR= ${CROSS}ar
ARFLAGS= ruvs
AS= ${CROSS}gcc -c
ASFLAGS= -march=rv64gc -mabi=lp64d
CC= ${CROSS}gcc -c
CFLAGS= -O2 -g -fno-strict-aliasing -march=rv64gc -mabi=lp64d\
 -Wuninitialized -Wunused-variable -Wreturn-type -Wimplicit\
 -I$ROOT/Linux/riscv64/include -I$ROOT/Linux/386/include -I$ROOT/include\
 -include $ROOT/include/native64-target.h -DLINUX_RISCV64 $DISMODELFLAGS
ANSICPP=
LD= ${CROSS}gcc
LDFLAGS= -march=rv64gc -mabi=lp64d
SYSLIBS=
YACC= iyacc
YFLAGS= -d
