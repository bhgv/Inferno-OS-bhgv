# Build the terminal emulator with the existing portable device configuration.
# Graphics devices remain omitted; explicit native64 font startup adds only its headless library.
EMUMKFILE=mkfile-console
EMUDIRS=\
	lib9\
	libbio\
	libmp\
	libsec\
	libmath\
	$NATIVE64_FREETYPE_DIR\
	utils/iyacc\
	limbo\
	libinterp\
	libkeyring\
	libdynld\
	emu\
