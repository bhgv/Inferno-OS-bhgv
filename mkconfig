#
#	Set the following 4 variables.  The host system is the system where
#	the software will be built; the target system is where it will run.
#	They are almost always the same.

#	On Nt systems, the ROOT path MUST be of the form `drive:/path'
ROOT=$ROOT

#
#	Specify the flavour of Tk (std for standard builds)
#
TKSTYLE=std

TOUCHSCREEN_CAPACITIVE=0 # Explicit default prevents an empty -D from consuming the next include option.
EXTWINFLAGS= # Set -DEXT_WIN only for Android GLES/Clutter archives, empty for framebuffer.
WINDOW_BACKEND=fb		# andr, clutter, x11a, fb

#
#	Except for building kernels, SYSTARG must always be the same as SYSHOST
#
SYSHOST=Linux #Nt  #Plan9		# build system OS type (Hp, Inferno, Irix, Linux, MacOSX, Nt, Plan9, Solaris)
SYSTARG=Linux #Android #Linux  #$SYSHOST		# target system OS type (Hp, Inferno, Irix, Linux, Nt, Plan9, Solaris)

#
#	specify the architecture of the target system - Plan 9 imports it from the
#	environment; for other systems it is usually just hard-coded
#
OBJTYPE=arm #386 #arm  #386			# target system object type (eg, 386, arm, mips, power, s800, sparc)
#OBJTYPE=$objtype
#
# New 64-bit target profiles (canonical OBJTYPE names):
# Linux x86-64: SYSHOST=Linux SYSTARG=Linux OBJTYPE=amd64 CROSS=
# Linux AArch64/arm64: SYSHOST=Linux SYSTARG=Linux OBJTYPE=arm64
#   CROSS=aarch64-linux-gnu- for cross compilation; empty for a native build.
# Linux RISC-V64: SYSHOST=Linux SYSTARG=Linux OBJTYPE=riscv64
#   CROSS=riscv64-linux-gnu- for cross compilation; empty for a native build.
# Android: SYSHOST=Linux SYSTARG=Android OBJTYPE=arm64 (arm64-v8a)
# Android: SYSHOST=Linux SYSTARG=Android OBJTYPE=amd64 (x86_64)
#   Set ANDROID_NDK_HOME; API/toolchain defaults are in the selected mkfile.
# These are core/library toolchain profiles, not completed platform emu ports.
# See doc/build-native64.md for missing platform files and coherent model rules.
# Optional experimental scalar model: DISMODELFLAGS='-DDIS_WORD32=1'
# Experimental Linux console scalar-only startup (ARM64 cross/QEMU verified):
# DISMODELFLAGS='-DDIS_WORD32=1 -DDIS64_PILOT_LOADER=1 -DDIS_NATIVE64_SCALAR_BOOT=1'
# No builtin modules, legacy Dis images or native plugins in that mode.
# Rebuild every linked runtime object with the same model; default remains legacy.


# Coherent experimental caller leases (Linux amd64/arm64/riscv64 console only):
# python3 utils/configure.py --host linux --arch arm64 --console \
#   --native64-scalar-boot --native64-math-boot --native64-sys-io-boot \
#   --native64-caller-guard
# Optional Linux-only headless font registration: add --native64-freetype-boot.
# This registers six fixed entries with fresh -H -M Freetype metadata, not AWM/file imports.
# Rebuild every runtime object after changing model/guard flags; file calls remain closed.

# Classic emulator entry, normally mkfile; configure.py --console selects mkfile-console.
EMUMKFILE=mkfile

#
#	no changes required beyond this point
#
OBJDIR=$SYSTARG/$OBJTYPE

<$ROOT/mkfiles/mkhost-$SYSHOST			# variables appropriate for host system
<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE	# variables used to build target object type
